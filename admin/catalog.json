---
layout: null
permalink: /admin/catalog.json
---
[{% for post in site.posts %}{% assign shown_category = '竞赛题解' %}{% if post.categories contains '个人/比赛经历' %}{% assign shown_category = '个人/比赛经历' %}{% endif %}{% assign shown_categories = shown_category | split: '|' %}{"path":{{ post.path | jsonify }},"title":{{ post.title | jsonify }},"date":{{ post.date | date: '%Y-%m-%d' | jsonify }},"categories":{{ shown_categories | jsonify }},"pinned":{% if post.pinned == true %}true{% else %}false{% endif %},"locked":{% if post.password_hash %}true{% else %}false{% endif %}}{% unless forloop.last %},{% endunless %}{% endfor %}]
